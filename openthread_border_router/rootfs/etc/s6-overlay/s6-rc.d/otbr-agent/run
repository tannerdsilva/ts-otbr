#!/usr/bin/with-contenv bashio
# vim: ft=bash
# shellcheck shell=bash
# ==============================================================================
# OpenThread BorderRouter start script
# ==============================================================================

# shellcheck source=./openthread_border_router/rootfs/etc/s6-overlay/scripts/otbr-agent-common
. /etc/s6-overlay/scripts/otbr-agent-common

declare backbone_if
declare device
declare baudrate
declare flow_control
declare migrate_flow_control
declare otbr_log_level_int
declare otbr_rest_listen
declare otbr_rest_listen_port
declare ula_prefix

# Cleanup unused configs
if bashio::config.exists 'autoflash_firmware'; then
    bashio::addon.option 'autoflash_firmware'
fi

backbone_if=""

# Backbone network interface can be configured by user or auto-detected by looking for the primary network interface in the system.
# If no primary network interface is found, the app will exit with an error and ask the user to configure a backbone network interface in the app configuration.
if bashio::config.has_value 'backbone_interface'; then
    backbone_if="$(bashio::config 'backbone_interface')"
else
    backbone_if="$(bashio::api.supervisor 'GET' '/network/info' '' 'first(.interfaces[] | select (.primary == true)) .interface // empty')"
    if [ -z "${backbone_if}" ]; then
        # If no backbone interface is found, exit with error
        bashio::exit.nok "No primary network interface found. Please configure a backbone network interface in the apps configuration."
    fi
fi

# Check if IPv6 forwarding is enabled
if [ "$(cat /proc/sys/net/ipv6/conf/all/forwarding)" != "1" ]; then
    bashio::log.warning "IPv6 routing/forwarding is not enabled! Make sure the Home Assistant host has IPv6 forwarding enabled."
fi

device=$(bashio::config 'device')

if bashio::config.has_value 'network_device'; then
    device="/tmp/ttyOTBR"
fi

baudrate=$(bashio::config 'baudrate')
flow_control=""

if bashio::config.true 'flow_control'; then
    flow_control="&uart-flow-control"
    migrate_flow_control="hardware"
else
    flow_control="&uart-init-deassert"
    migrate_flow_control="none"
fi

otbr_log_level_int="$(otbr_log_level_to_int)" \
    || bashio::exit.nok "Unknown otbr_log_level: $(bashio::config otbr_log_level)"

# shellcheck disable=SC2015
mkdir -p /data/thread && ln -sft /var/lib /data/thread || bashio::exit.nok "Could not create directory /var/lib/thread to store Thread data."

# We compile the OTBR with firewall support, so otbr-agent tries to update the
# ipsets. Therefore create the ipsets always (even when the firewall is later
# disabled) so otbr-agent never fails when it tries to manipulate them.

# ==============================================================================
# Early IPv6 defaults – any newly created interface (incl. wpan0) inherits these
# ==============================================================================
# This closes the race between interface creation and the later per-interface
# waiter. The backbone interface is already up, so it is unaffected.
sysctl -w net.ipv6.conf.default.accept_ra=0          >/dev/null 2>&1 || true
sysctl -w net.ipv6.conf.default.accept_ra_defrtr=0   >/dev/null 2>&1 || true
sysctl -w net.ipv6.conf.default.accept_ra_pinfo=0    >/dev/null 2>&1 || true
sysctl -w net.ipv6.conf.default.forwarding=1         >/dev/null 2>&1 || true

# Optional:
# sysctl -w net.ipv6.conf.default.router_solicitations=0 >/dev/null 2>&1 || true

# ==============================================================================
# OTBR hardened nftables firewall (IPv6) + ipset compatibility layer
# ==============================================================================
# Design goals:
#   • No Ethernet control-plane leakage onto the Thread radio
#   • No routing loops between backbone and mesh
#   • Strict anti-spoofing of Thread-sourced addresses arriving from Ethernet
#   • Preserve normal Thread/Matter operation and intra-mesh relay
#
# Directionality:
#   backbone → Thread  : strict (default-deny unsolicited unicast + selective multicast)
#   Thread  → backbone : permissive
#   local OUTPUT → Thread : block host-generated discovery & RAs
# ==============================================================================

ipset create -exist otbr-ingress-deny-src       hash:net family inet6
ipset create -exist otbr-ingress-deny-src-swap  hash:net family inet6
ipset create -exist otbr-ingress-allow-dst      hash:net family inet6
ipset create -exist otbr-ingress-allow-dst-swap hash:net family inet6

nft delete table ip6 otbr 2>/dev/null || true

nft -f - <<EOF
table ip6 otbr {
    set otbr-ingress-deny-src {
        type ipv6_addr
        flags interval
        auto-merge
    }
    set otbr-ingress-deny-src-swap {
        type ipv6_addr
        flags interval
        auto-merge
    }
    set otbr-ingress-allow-dst {
        type ipv6_addr
        flags interval
        auto-merge
    }
    set otbr-ingress-allow-dst-swap {
        type ipv6_addr
        flags interval
        auto-merge
    }

	# ------------------------------------------------------------------
	# FORWARD - Use filter priority, NOT mangle
	# ------------------------------------------------------------------
	chain forward {
		type filter hook forward priority filter; policy drop;
		oifname "${thread_if}" jump otbr_to_thread
		iifname "${thread_if}" jump otbr_from_thread
	}

	# ------------------------------------------------------------------
	# INPUT - Use filter priority
	# ------------------------------------------------------------------
	chain input {
		type filter hook input priority filter; policy drop;
		
		iifname "lo" counter accept
		ct state invalid counter drop
		ct state established,related counter accept
		
		iifname "${thread_if}" meta pkttype { broadcast, multicast } counter drop
		iifname "${thread_if}" ip6 saddr fe80::/10 ip6 saddr != fe80::1 counter drop
		iifname "${thread_if}" ip6 saddr @otbr-ingress-deny-src counter reject
		
		iifname "${backbone_if}" icmpv6 type { mld-listener-query, mld-listener-report, mld2-listener-report } counter accept
		iifname "${thread_if}" icmpv6 type { mld-listener-query, mld-listener-report, mld2-listener-report } counter drop
		
		# ICMPv6 errors WITH address restriction
		iifname "${thread_if}" icmpv6 type { destination-unreachable, packet-too-big, time-exceeded, parameter-problem } 
			ip6 saddr @otbr-ingress-allow-dst limit rate 10/second burst 5 packets accept
		
		# ND WITHOUT hoplimit (compatibility)
		iifname "${thread_if}" icmpv6 type { nd-neighbor-solicit, nd-neighbor-advert } 
			ip6 saddr @otbr-ingress-allow-dst limit rate 20/second burst 5 packets accept
		
		iifname "${thread_if}" icmpv6 type nd-router-advert counter drop
		iifname "${thread_if}" udp dport { 1900, 5353, 5355 } counter drop
		iifname "${thread_if}" udp dport 61631 counter drop
		
		# Allow Thread-sourced traffic (interface-based, more permissive)
		iifname "${thread_if}" ip6 saddr @otbr-ingress-allow-dst meta l4proto { tcp, udp } ct state new counter accept
		
		iifname "${thread_if}" ip6 daddr fe80::/10 counter reject
		
		# LOG before drop (critical for debugging)
		counter log prefix "OTBR_INPUT_DROP: " level warn reject
	}

	# ------------------------------------------------------------------
	# OUTPUT
	# ------------------------------------------------------------------
	chain output {
		type filter hook output priority filter; policy accept;
		
		oifname "lo" counter accept
		oifname "${backbone_if}" icmpv6 type { mld-listener-query, mld-listener-report, mld2-listener-report } counter accept
		oifname "${thread_if}" icmpv6 type { mld-listener-query, mld-listener-report, mld2-listener-report } counter drop
		oifname "${backbone_if}" icmpv6 type nd-router-advert counter accept
		oifname "${thread_if}" udp dport 5353 counter drop
		oifname "${thread_if}" udp sport 5353 counter drop
		oifname "${thread_if}" udp dport 5355 meta pkttype multicast counter drop
		oifname "${thread_if}" udp dport 1900 meta pkttype multicast counter drop
		oifname "${thread_if}" icmpv6 type nd-router-advert counter drop
		oifname "${thread_if}" ip6 daddr fe80::/10 meta l4proto udp counter drop
	}

	# ------------------------------------------------------------------
	# FORWARD CHAINS
	# ------------------------------------------------------------------
	chain otbr_to_thread {
		iifname "${backbone_if}" jump from_backbone_to_thread
		iifname "${thread_if}" jump from_thread_to_thread
		counter drop
	}

	chain from_backbone_to_thread {
		ct state invalid counter drop
		
		# Multicast control protocols first
		meta pkttype { broadcast, multicast } udp dport { 546, 547, 1900, 5350, 5351, 5353, 5355, 19788, 61631 } counter drop
		udp dport { 546, 547 } counter drop
		
		ct state established,related accept
		
		# ICMPv6 errors WITH address restriction
		icmpv6 type { destination-unreachable, packet-too-big, time-exceeded, parameter-problem } 
			ip6 daddr @otbr-ingress-allow-dst limit rate 10/second burst 5 packets accept
		icmpv6 type { echo-request, echo-reply } 
			ip6 daddr @otbr-ingress-allow-dst limit rate 10/second burst 5 packets accept
		
		# ND WITHOUT hoplimit (compatibility)
		icmpv6 type { nd-router-solicit, nd-neighbor-solicit, nd-neighbor-advert, nd-redirect } 
			ip6 daddr @otbr-ingress-allow-dst limit rate 20/second burst 5 packets accept
		
		ip6 saddr @otbr-ingress-deny-src counter reject
		ip6 daddr fe80::/10 counter reject
		ip6 daddr @otbr-ingress-allow-dst meta l4proto { tcp, udp } ct state new counter accept
		
		# LOG before drop
		counter log prefix "OTBR_BB2THR_DROP: " level warn reject
	}

	chain from_thread_to_thread {
		counter accept
	}

	chain otbr_from_thread {
		oifname "${backbone_if}" jump from_thread_to_backbone
		oifname "${thread_if}" jump from_thread_to_thread
		counter drop
	}

	chain from_thread_to_backbone {
		ct state invalid counter drop
		
		meta pkttype { broadcast, multicast } icmpv6 type { mld-listener-query, mld-listener-report, mld2-listener-report } counter drop
		udp dport 61631 counter drop
		udp sport 61631 counter drop
		meta pkttype { broadcast, multicast } udp dport { 1900, 5353, 5355 } counter drop
		
		ct state established,related accept
		
		# ICMPv6 errors WITH address restriction
		icmpv6 type { destination-unreachable, packet-too-big, time-exceeded, parameter-problem } 
			ip6 saddr @otbr-ingress-allow-dst limit rate 10/second burst 5 packets accept
		icmpv6 type { echo-request, echo-reply } 
			ip6 saddr @otbr-ingress-allow-dst limit rate 10/second burst 5 packets accept
		
		# ND WITHOUT hoplimit (compatibility)
		icmpv6 type { nd-router-solicit, nd-neighbor-solicit, nd-neighbor-advert, nd-redirect } 
			ip6 saddr @otbr-ingress-allow-dst limit rate 20/second burst 5 packets accept
		
		icmpv6 type nd-router-advert counter drop
		ip6 saddr @otbr-ingress-allow-dst accept
		ip6 saddr fe80::/10 counter reject
		
		# LOG before drop
		counter log prefix "OTBR_THR2BB_DROP: " level warn reject
	}
}
EOF


# ------------------------------------------------------------------
# Punch a hole in Docker's default-deny IPv6 FORWARD policy.
# Docker only accepts traffic from hassio/docker0; Thread traffic
# (backbone ↔ wpan0) would otherwise be dropped.
# DOCKER-USER is evaluated first and is the supported extension point.
# ------------------------------------------------------------------
setup_docker_user_forward() {
  local backbone="${1}"
  local thread="${2}"

  # Wait briefly for Docker to create the chain (race on boot)
  local i=0
  while [ "$i" -lt 15 ]; do
    if nft list chain ip6 filter DOCKER-USER >/dev/null 2>&1; then
      break
    fi
    sleep 1
    i=$((i + 1))
  done

  if ! nft list chain ip6 filter DOCKER-USER >/dev/null 2>&1; then
    bashio::log.warning "ip6 filter DOCKER-USER not present; skipping Docker forward hole"
    return 0
  fi

  # Remove any previous rules we may have inserted (idempotent restart)
  # Match by comment so we don't touch other user rules.
  while nft -a list chain ip6 filter DOCKER-USER 2>/dev/null | \
        grep -q 'otbr-docker-forward'; do
    local handle
    handle=$(nft -a list chain ip6 filter DOCKER-USER 2>/dev/null | \
             awk '/otbr-docker-forward/ {print $NF; exit}')
    [ -n "$handle" ] || break
    nft delete rule ip6 filter DOCKER-USER handle "$handle" 2>/dev/null || break
  done

  # Bidirectional allow for the Thread interface
  nft insert rule ip6 filter DOCKER-USER \
    iifname "${backbone}" oifname "${thread}" \
    counter accept comment \"otbr-docker-forward\"

  nft insert rule ip6 filter DOCKER-USER \
    iifname "${thread}" oifname "${backbone}" \
    counter accept comment \"otbr-docker-forward\"

  # Catch-all for anything involving the Thread radio
  # (covers edge cases, hairpin, other interfaces)
  nft insert rule ip6 filter DOCKER-USER \
    oifname "${thread}" counter accept comment \"otbr-docker-forward\"

  nft insert rule ip6 filter DOCKER-USER \
    iifname "${thread}" counter accept comment \"otbr-docker-forward\"

  bashio::log.info "Inserted Docker DOCKER-USER forward rules for ${backbone} ↔ ${thread}"
}

setup_docker_user_forward "${backbone_if}" "${thread_if}"

# Sync current ipset contents into the nft sets so that any prefixes
# already present (or later updated by otbr-agent via the classic ipset
# interface) become visible to the nftables rules.
sync_ipset() {
    local ipset_name="$1"
    local nft_set="$2"
    local elements=()
    local line entry

    while IFS= read -r line; do
        if [[ $line =~ ^add[[:space:]]+[^[:space:]]+[[:space:]]+([^[:space:]]+) ]]; then
            entry="${BASH_REMATCH[1]}"
            elements+=("$entry")
        fi
    done < <(ipset list "$ipset_name" -o save 2>/dev/null || true)

    if (( ${#elements[@]} > 0 )); then
        nft -f - <<EOF 2>/dev/null || true
flush set ip6 otbr ${nft_set}
add element ip6 otbr ${nft_set} { $(IFS=,; echo "${elements[*]}") }
EOF
    else
        nft flush set ip6 otbr "$nft_set" 2>/dev/null || true
    fi
}

sync_ipset otbr-ingress-deny-src  otbr-ingress-deny-src
sync_ipset otbr-ingress-allow-dst otbr-ingress-allow-dst

if bashio::config.true 'firewall'; then
    bashio::log.info "OTBR hardened nftables firewall ACTIVE (strict backbone→Thread, permissive Thread→backbone, host control-plane blocked on radio)"
else
    # Disable path: open the critical ingress chain so behaviour matches stock OTBR
    nft flush chain ip6 otbr from_backbone_to_thread
    nft add rule ip6 otbr from_backbone_to_thread accept
    bashio::log.info "OTBR firewall disabled — from-backbone-to-Thread set to ACCEPT"
fi

# REST listen logic (unchanged)
otbr_rest_listen="::"
otbr_rest_listen_port="$(bashio::addon.port 8081)"
if ! bashio::var.has_value "${otbr_rest_listen_port}"; then
    otbr_rest_listen="$(bashio::addon.ip_address)"
    otbr_rest_listen_port="8081"
elif [ "${otbr_rest_listen_port}" != "8081" ]; then
    bashio::log.warning "Custom OpenThread REST API port is not supported. Using 8081."
    otbr_rest_listen_port="8081"
fi

# Store REST API listen information for check script
echo "${otbr_rest_listen}" > /tmp/otbr-agent-rest-api
echo "${otbr_rest_listen_port}" >> /tmp/otbr-agent-rest-api

# Migrate OTBR settings to new adapter if needed
bashio::log.info "Migrating OTBR settings if needed..."
python3 /usr/local/bin/migrate_otbr_settings.py \
    --adapter "${device}" \
    --baudrate "${baudrate}" \
    --flow-control "${migrate_flow_control}" \
    --data-dir /data/thread/

# Optional suggested BR ULA prefix
ula_prefix=""
if bashio::config.has_value 'ula_prefix'; then
    ula_prefix="$(bashio::config 'ula_prefix')"
fi

# Build the optional --ula-prefix argument
ula_prefix_arg=""
if bashio::var.has_value "${ula_prefix}"; then
    ula_prefix_arg="--ula-prefix ${ula_prefix}"
    bashio::log.info "Using suggested BR ULA prefix: ${ula_prefix}"
fi

bashio::log.info "Starting OTBR agent..."

# shellcheck disable=SC2086
exec s6-notifyoncheck -d -s 300 -w 300 -n 0 stdbuf -oL \
    "/usr/sbin/otbr-agent" -I ${thread_if} -B "${backbone_if}" \
        --rest-listen-address "${otbr_rest_listen}" \
        -d${otbr_log_level_int} -v -s \
        ${ula_prefix_arg} \
        "spinel+hdlc+uart://${device}?uart-baudrate=${baudrate}${flow_control}" \
        "trel://${backbone_if}"