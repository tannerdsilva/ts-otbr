#!/usr/bin/with-contenv bashio
# vim: ft=bash
# shellcheck shell=bash
# ==============================================================================
# OpenThread BorderRouter start script
# ==============================================================================

# shellcheck source=./openthread_border_router/rootfs/etc/s6-overlay/scripts/otbr-agent-common
. /etc/s6-overlay/scripts/otbr-agent-common

declare backbone_if
declare device
declare baudrate
declare flow_control
declare migrate_flow_control
declare otbr_log_level_int
declare otbr_rest_listen
declare otbr_rest_listen_port

# Cleanup unused configs
if bashio::config.exists 'autoflash_firmware'; then
    bashio::addon.option 'autoflash_firmware'
fi

backbone_if=""

# Backbone network interface can be configured by user or auto-detected by looking for the primary network interface in the system.
# If no primary network interface is found, the app will exit with an error and ask the user to configure a backbone network interface in the app configuration.
if bashio::config.has_value 'backbone_interface'; then
    backbone_if="$(bashio::config 'backbone_interface')"
else
    backbone_if="$(bashio::api.supervisor 'GET' '/network/info' '' 'first(.interfaces[] | select (.primary == true)) .interface // empty')"
    if [ -z "${backbone_if}" ]; then
        # If no backbone interface is found, exit with error
        bashio::exit.nok "No primary network interface found. Please configure a backbone network interface in the apps configuration."
    fi
fi

# Check if IPv6 forwarding is enabled
if [ "$(cat /proc/sys/net/ipv6/conf/all/forwarding)" != "1" ]; then
    bashio::log.warning "IPv6 routing/forwarding is not enabled! Make sure the Home Assistant host has IPv6 forwarding enabled."
fi

device=$(bashio::config 'device')

if bashio::config.has_value 'network_device'; then
    device="/tmp/ttyOTBR"
fi

baudrate=$(bashio::config 'baudrate')
flow_control=""

if bashio::config.true 'flow_control'; then
    flow_control="&uart-flow-control"
    migrate_flow_control="hardware"
else
    flow_control="&uart-init-deassert"
    migrate_flow_control="none"
fi

otbr_log_level_int="$(otbr_log_level_to_int)" \
    || bashio::exit.nok "Unknown otbr_log_level: $(bashio::config otbr_log_level)"

# shellcheck disable=SC2015
mkdir -p /data/thread && ln -sft /var/lib /data/thread || bashio::exit.nok "Could not create directory /var/lib/thread to store Thread data."

# We compile the OTBR with firewall support, so otbr-agent tries to update the
# ipsets. Therefor, create ipsets always to avoid errors from otbr-agent. Just
# the ipsets  won't have an effect in practice when the firewall is disabled.

# ==============================================================================
# OTBR firewall – hardened nftables (IPv6-first) + compatibility ipsets
# ==============================================================================
# Goal: make the "inverted switching tree" (Thread devices routing via the
#       backbone switch / multi-hop-via-LAN) impossible while keeping every
#       legitimate Thread / NAT64 / REST function working.
# ==============================================================================

# --- 1. Compatibility ipsets (otbr-agent still expects these) -----------------
ipset create -exist otbr-ingress-deny-src        hash:net family inet6
ipset create -exist otbr-ingress-deny-src-swap   hash:net family inet6
ipset create -exist otbr-ingress-allow-dst       hash:net family inet6
ipset create -exist otbr-ingress-allow-dst-swap  hash:net family inet6

# --- 2. Clean slate -----------------------------------------------------------
nft delete table ip6 otbr 2>/dev/null || true
nft delete table ip   otbr 2>/dev/null || true

# --- 3. IPv6 table (the real defense) -----------------------------------------
nft -f - <<EOF
table ip6 otbr {
    # Sets that mirror the classic ipsets (we own them; agent may also touch
    # the ipset versions – both can coexist safely)
    set otbr-ingress-deny-src {
        type ipv6_addr
        flags interval
        auto-merge
    }
    set otbr-ingress-deny-src-swap {
        type ipv6_addr
        flags interval
        auto-merge
    }
    set otbr-ingress-allow-dst {
        type ipv6_addr
        flags interval
        auto-merge
    }
    set otbr-ingress-allow-dst-swap {
        type ipv6_addr
        flags interval
        auto-merge
    }

    # ------------------------------------------------------------------
    # Main forward hook – runs very early (priority -150)
    # Only touches packets that involve the Thread interface.
    # Everything else falls through to the system policy (normally accept).
    # ------------------------------------------------------------------
    chain forward {
        type filter hook forward priority -150; policy accept;

        # Traffic entering the Thread network
        oifname "${thread_if}" jump ingress

        # Traffic leaving the Thread network
        iifname "${thread_if}" jump egress
    }

    # ------------------------------------------------------------------
    # INGRESS  (packets going *into* Thread, i.e. from backbone → Thread)
    # This is the primary place we kill inverted trees.
    # ------------------------------------------------------------------
    chain ingress {
        # 1. Must come from the real backbone interface – nothing else
        iifname != "${backbone_if}" counter drop

        # 2. Connection tracking – always allow return traffic
        ct state established,related accept

        # 3. ICMPv6 – full modern support + ND hardening
        #    (hop-limit 255 is required for all ND messages)
        icmpv6 type {
            destination-unreachable,
            packet-too-big,
            time-exceeded,
            parameter-problem,
            echo-request,
            echo-reply
        } accept

        icmpv6 type {
            nd-router-solicit,
            nd-router-advert,
            nd-neighbor-solicit,
            nd-neighbor-advert,
            nd-redirect,
            mld-listener-query,
            mld-listener-report,
            mld2-listener-report
        } ip6 hoplimit 255 accept

        # 4. Deny list (populated by otbr-agent or by us)
        ip6 saddr @otbr-ingress-deny-src counter drop

        # 5. Allow-list for destinations inside Thread
        ip6 daddr @otbr-ingress-allow-dst accept

        # 6. Multicast / broadcast (Thread needs this) – still accept
        meta pkttype { multicast, broadcast } accept

        # 7. Everything else unicast → drop (this is the hard stop)
        meta pkttype unicast counter drop

        # 8. Final safety net
        counter drop
    }

    # ------------------------------------------------------------------
    # EGRESS  (packets leaving Thread → backbone)
    # Prevents Thread devices from using the LAN as a multi-hop path
    # back into other Thread devices (the classic inverted tree).
    # ------------------------------------------------------------------
    chain egress {
        # 1. Must leave toward the backbone
        oifname != "${backbone_if}" counter drop

        # 2. Established / related always OK
        ct state established,related accept

        # 3. ICMPv6 (same set as ingress)
        icmpv6 type {
            destination-unreachable,
            packet-too-big,
            time-exceeded,
            parameter-problem,
            echo-request,
            echo-reply
        } accept

        icmpv6 type {
            nd-router-solicit,
            nd-router-advert,
            nd-neighbor-solicit,
            nd-neighbor-advert,
            nd-redirect,
            mld-listener-query,
            mld-listener-report,
            mld2-listener-report
        } ip6 hoplimit 255 accept

        # 4. Source must not be on the deny list
        ip6 saddr @otbr-ingress-deny-src counter drop

        # 5. Destination must be on the allow list (off-mesh / LAN prefixes)
        #    This is what stops Thread-to-Thread traffic from hair-pinning
        #    through the switch.
        ip6 daddr @otbr-ingress-allow-dst accept

        # 6. Multicast OK
        meta pkttype { multicast, broadcast } accept

        # 7. Final drop for anything else
        counter drop
    }
}
EOF

# --- 4. IPv4 table (NAT64 only) -----------------------------------------------
if bashio::config.true 'nat64'; then
    nft -f - <<EOF
table ip otbr {
    chain prerouting {
        type filter hook prerouting priority -150; policy accept;
        iifname "${thread_if}" meta mark set ${otbr_fw_mark}
    }

    chain forward {
        type filter hook forward priority -150; policy accept;

        # Outbound marked traffic toward backbone
        meta mark ${otbr_fw_mark} oifname "${backbone_if}" accept

        # Return traffic (conntrack)
        ct state established,related iifname "${backbone_if}" oifname "${thread_if}" accept
    }

    chain postrouting {
        type nat hook postrouting priority srcnat; policy accept;
        meta mark ${otbr_fw_mark} masquerade
    }
}
EOF
    bashio::log.info "NAT64 nftables rules installed (mark ${otbr_fw_mark})"
fi

# --- 5. Firewall enable / disable logging -------------------------------------
if bashio::config.true 'firewall'; then
    bashio::log.info "OTBR firewall (nftables) is ACTIVE – inverted-tree protection enabled"
else
    # When the user turns the firewall option off we still keep the table
    # but make both chains pure ACCEPT so behaviour matches the old “open”
    # path.  This keeps the structure ready for the next restart.
    nft flush chain ip6 otbr ingress
    nft flush chain ip6 otbr egress
    nft add rule ip6 otbr ingress accept
    nft add rule ip6 otbr egress  accept
    bashio::log.info "OTBR firewall option is off – nftables chains set to ACCEPT"
fi

# --- 6. REST API listen (unchanged logic, just kept for completeness) --------
otbr_rest_listen="::"
otbr_rest_listen_port="$(bashio::addon.port 8081)"
if ! bashio::var.has_value "${otbr_rest_listen_port}"; then
    otbr_rest_listen="$(bashio::addon.ip_address)"
    otbr_rest_listen_port="8081"
elif [ "${otbr_rest_listen_port}" != "8081" ]; then
    bashio::log.warning "Custom OpenThread REST API port is not supported. Using 8081."
    otbr_rest_listen_port="8081"
fi

# Store REST API listen information for check script
echo "${otbr_rest_listen}" > /tmp/otbr-agent-rest-api
echo "${otbr_rest_listen_port}" >> /tmp/otbr-agent-rest-api

# Migrate OTBR settings to new adapter if needed
bashio::log.info "Migrating OTBR settings if needed..."
python3 /usr/local/bin/migrate_otbr_settings.py \
    --adapter "${device}" \
    --baudrate "${baudrate}" \
    --flow-control "${migrate_flow_control}" \
    --data-dir /data/thread/

bashio::log.info "Starting otbr-agent..."
# shellcheck disable=SC2086
exec s6-notifyoncheck -d -s 300 -w 300 -n 0 stdbuf -oL \
    "/usr/sbin/otbr-agent" -I ${thread_if} -B "${backbone_if}" \
        --rest-listen-address "${otbr_rest_listen}" \
        -d${otbr_log_level_int} -v -s \
        "spinel+hdlc+uart://${device}?uart-baudrate=${baudrate}${flow_control}" \
        "trel://${backbone_if}"
