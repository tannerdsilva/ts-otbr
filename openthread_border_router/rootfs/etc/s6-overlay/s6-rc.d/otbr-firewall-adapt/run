#!/usr/bin/with-contenv bashio
# shellcheck shell=bash

# Disable automatic exit on error – we handle failures ourselves
set +e

# -----------------------------------------------------------------
# Configuration
# -----------------------------------------------------------------
INTERVAL=$(bashio::config 'adaptive_firewall_interval' 2>/dev/null || echo 5)
ENABLED=$(bashio::config 'adaptive_firewall' 2>/dev/null || echo true)

if [[ "${ENABLED}" != "true" && "${ENABLED}" != "True" && "${ENABLED}" != "1" ]]; then
    bashio::log.info "Adaptive firewall disabled – idling"
    exec sleep infinity
fi

# -----------------------------------------------------------------
# Helpers – every ot-ctl call is fully failure-tolerant
# -----------------------------------------------------------------
get_omr_prefix() {
    ot-ctl br omrprefix 2>/dev/null | awk '/Local:/ {print $2; exit}' || true
}

get_mesh_prefix() {
    ot-ctl ipaddr 2>/dev/null | grep -oE 'fd[0-9a-f:]+:[0-9a-f]+::/64' | head -1 || true
}

query_same_ail() {
    local multi_ail peer_count

    multi_ail=$(ot-ctl br multiail state 2>/dev/null | tr '[:upper:]' '[:lower:]' || true)
    peer_count=$(ot-ctl br peers 2>/dev/null | grep -c 'rloc16:' || true)
    peer_count=${peer_count//[^0-9]/}
    peer_count=${peer_count:-0}

    if (( peer_count > 0 )) && [[ "${multi_ail}" != *"detected: yes"* ]]; then
        return 0
    fi
    return 1
}

apply_strict() {
    local omr mesh
    omr=$(get_omr_prefix)
    mesh=$(get_mesh_prefix)

    [[ -z "${omr}" ]] && {
        bashio::log.warning "STRICT: could not determine OMR prefix – skipping"
        return
    }

    bashio::log.debug "Applying STRICT (OMR=${omr})"
    ipset add -exist otbr-ingress-deny-src "${omr}" 2>/dev/null || true
    [[ -n "${mesh}" ]] && ipset add -exist otbr-ingress-deny-src "${mesh}" 2>/dev/null || true

    ipset flush otbr-ingress-allow-dst 2>/dev/null || true
    ipset add -exist otbr-ingress-allow-dst "${omr}" 2>/dev/null || true
}

apply_relaxed() {
    local omr mesh
    omr=$(get_omr_prefix)
    mesh=$(get_mesh_prefix)

    [[ -z "${omr}" ]] && {
        bashio::log.warning "RELAXED: could not determine OMR prefix – skipping"
        return
    }

    bashio::log.debug "Applying RELAXED (OMR=${omr})"
    ipset del otbr-ingress-deny-src "${omr}" 2>/dev/null || true

    ipset add -exist otbr-ingress-allow-dst "${omr}" 2>/dev/null || true
    [[ -n "${mesh}" ]] && ipset add -exist otbr-ingress-allow-dst "${mesh}" 2>/dev/null || true
}

# -----------------------------------------------------------------
# Wait for prerequisites
# -----------------------------------------------------------------
bashio::log.info "Waiting for otbr-agent and ipsets..."
sleep 8

MAX_WAIT=90
count=0
while true; do
    if ipset list otbr-ingress-deny-src &>/dev/null; then
        if ot-ctl state &>/dev/null; then
            bashio::log.info "otbr-agent and ipsets are ready"
            break
        fi
    fi

    count=$((count + 1))
    if [[ $count -ge $MAX_WAIT ]]; then
        bashio::log.error "Timed out waiting for otbr-agent / ipsets"
        exec sleep infinity
    fi
    sleep 2
done

# -----------------------------------------------------------------
# Main loop – never exit
# -----------------------------------------------------------------
current_mode=""
force_first=true
bashio::log.info "otbr-firewall-adapt started (interval ${INTERVAL}s)"

while true; do
    # Protect the whole iteration so a single failure cannot kill us
    {
        if query_same_ail; then
            desired="relaxed"
        else
            desired="strict"
        fi

        if [[ "${desired}" != "${current_mode}" || "${force_first}" == "true" ]]; then
            if [[ "${desired}" == "relaxed" ]]; then
                apply_relaxed
            else
                apply_strict
            fi
            current_mode="${desired}"
            force_first=false
            bashio::log.info "Firewall mode → ${desired}"
        fi
    } || bashio::log.warning "Iteration failed – will retry"

    sleep "${INTERVAL}"
done