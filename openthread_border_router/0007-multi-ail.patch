+bool RoutingManager::HasSameAilPeerBrs(void) const
+{
+    // Multi-AIL detection and peer-BR tracking are only available when the
+    // corresponding config options are enabled.
+#if OPENTHREAD_CONFIG_BORDER_ROUTING_MULTI_AIL_DETECTION_ENABLE && \
+    OPENTHREAD_CONFIG_BORDER_ROUTING_TRACK_PEER_BR_INFO_ENABLE
+
+    // The Multi-AIL detector and the peer-BR count live in the Border
+    // Routing platform / tracker layer.  We query them through the public
+    // C API so the implementation stays independent of internal class layout.
+    otBorderRoutingMultiAilState multiAilState;
+    uint16_t                     peerBrCount = 0;
+
+    // These functions are provided by the Multi-AIL / peer-BR feature.
+    // If the platform has not yet implemented the exact names, map them
+    // to the real symbols that exist in your tree (otBorderRoutingIsMultiAilDetected,
+    // otBorderRoutingCountPeerBrs, etc.).
+    if (otBorderRoutingGetMultiAilState(GetInstancePtr(), &multiAilState) != OT_ERROR_NONE)
+    {
+        return false;
+    }
+
+    peerBrCount = otBorderRoutingCountPeerBrs(GetInstancePtr());
+
+    // Same-AIL peer BRs exist when we have peers *and* Multi-AIL is not detected.
+    return (peerBrCount > 0) && (multiAilState != OT_BORDER_ROUTING_MULTI_AIL_STATE_DETECTED);
+
+#else
+    OT_UNUSED_VARIABLE(this);
+    return false;
+#endif
+}
