+bool RoutingManager::HasSameAilPeerBrs(void) const
+{
+#if OPENTHREAD_CONFIG_BORDER_ROUTING_MULTI_AIL_DETECTION_ENABLE && \
+    OPENTHREAD_CONFIG_BORDER_ROUTING_TRACK_PEER_BR_INFO_ENABLE
+
+    // If Multi-AIL is detected, the peer BRs are on different infrastructure
+    // links → treat as "no same-AIL peers" for firewall purposes.
+    if (otBorderRoutingIsMultiAilDetected(&GetInstance()))
+    {
+        return false;
+    }
+
+    // Multi-AIL is not detected → peers (if any) are on the same AIL.
+    // aMinAge can be nullptr if we don't care about the age of the oldest peer.
+    return otBorderRoutingCountPeerBrs(GetInstancePtr(), nullptr) > 0;
+
+#else
+    OT_UNUSED_VARIABLE(this);
+    return false;
+#endif
+}
